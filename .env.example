# Groq API key — get a free one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use (Groq-hosted Llama models)
LLM_MODEL=llama-3.3-70b-versatile

# Max tool-use iterations per query before the agent must answer
MAX_AGENT_STEPS=8

# App config
APP_ENV=development
LOG_LEVEL=INFO
